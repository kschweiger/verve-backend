{
  "description": "Portable upload scenarios. Apply user_timezone first, pass timezone_name only when non-null, then upload file to each route. local_start is an expected display value without an offset, not an API timestamp.",
  "cases": [
    {
      "id": "berlin-gpx-utc",
      "file": "berlin-summer-utc.gpx",
      "description": "GPS selects Berlin while UTC instants are preserved.",
      "user_timezone": "America/Los_Angeles",
      "timezone_name": null,
      "routes": [
        "/activity/auto/"
      ],
      "expected": {
        "timezone": "Europe/Berlin",
        "start": "2026-08-10T08:00:00Z",
        "point_times": [
          "2026-08-10T08:00:00Z",
          "2026-08-10T08:05:00Z",
          "2026-08-10T08:10:00Z"
        ],
        "duration_seconds": 600,
        "heart_rates": [96, 108, 120],
        "elapsed_seconds": [0, 300, 600],
        "local_start": "2026-08-10T10:00:00"
      }
    },
    {
      "id": "berlin-gpx-offset",
      "file": "berlin-summer-offset.gpx",
